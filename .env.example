# Copy to .env for local development. Never commit .env.
# The app reads these from the process environment; load the file with `node --env-file=.env src/server.js`
# or export them in your shell.

# PostgreSQL connection string.
DATABASE_URL=postgres://kasturi:kasturi@localhost:5432/kasturi
# Set to true when the database requires SSL (for example an external Render database URL). Leave empty for local and Render internal URLs.
DATABASE_SSL=
# development or production. Production enables secure cookies and requires SESSION_SECRET.
NODE_ENV=development
# Port the web server listens on. Render sets this automatically.
PORT=3000
# Long random string used to sign session cookies. Required in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the site, used in links inside emails. No trailing slash. On Render, RENDER_EXTERNAL_URL is used if this is empty.
BASE_URL=http://localhost:3000

# First super admin, created on boot only if no admin exists yet. Password at least 8 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay API keys (Dashboard > Account & Settings > API keys). Use test keys until going live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# Mail delivery: set BREVO_API_KEY to send through the Brevo HTTP API (preferred), or the SMTP_* values. With neither, mail is logged as skipped.
BREVO_API_KEY=
# SMTP server host, for example smtp-relay.brevo.com or smtp.gmail.com.
SMTP_HOST=
# SMTP port: 587 (STARTTLS, default) or 465 (SSL).
SMTP_PORT=587
# SMTP login.
SMTP_USER=
# SMTP password or app password.
SMTP_PASS=

# Set to true to create demo sellers, auctions, bidders and bids on boot when there are no auctions. Never use on the live site.
SEED_DEMO=false
