<div class="wrap" data-server-now="<%= serverNow %>">
  <div class="page-head">
    <h1><%= user.company_name || user.name %></h1>
    <p>Bidder number <b><%= bidderNo %></b>. Quote it when you call or write to us.</p>
  </div>
  <%- include('_nav') %>

  <% if (user.kyc_status === 'rejected' && kycRequired) { %>
    <div class="notice notice-error" role="alert">
      <p><b>Your documents were not approved.</b><% if (user.kyc_note) { %> Reason given: <%= user.kyc_note %><% } %></p>
      <p>Correct the details or upload new documents, then submit them again on the <a href="/account/verification">verification page</a>.</p>
    </div>
  <% } %>

  <div class="cols">
    <div>
      <div class="panel">
        <div class="panel-head">
          <h2>Before you can bid</h2>
          <% if (eligibility.ok) { %><span class="tag tag-ok">Ready to bid</span><% } else { %><span class="tag tag-warn"><%= eligibility.steps.filter(function (s) { return !s.done; }).length %> left to do</span><% } %>
        </div>
        <div class="panel-body">
          <% if (!eligibility.steps.length) { %>
            <p>Nothing to do. You can bid in any live auction.</p>
          <% } else { %>
            <%- include('_steps') %>
            <% if (eligibility.ok) { %><p class="muted small">Everything is in place. You can bid in any live auction.</p><% } %>
          <% } %>
        </div>
      </div>

      <section class="section">
        <div class="row-between section-head"><h2>Your lots in live auctions</h2><a href="/account/bids">All my bids</a></div>
        <% if (!activeLots.length) { %>
          <div class="table-wrap"><div class="empty"><h3>You are not bidding on any open lots</h3><p>Open an auction from the <a href="/auctions">auction schedule</a> to place a bid.</p></div></div>
        <% } else { %>
          <div class="table-wrap">
            <table class="table table-stack">
              <thead><tr><th>Lot</th><th class="num">Your bid</th><th class="num">Highest bid</th><th>Standing</th><th>Closes in</th></tr></thead>
              <tbody>
                <% activeLots.forEach(function (l) { %>
                  <tr>
                    <td class="cell-main"><a class="primary" href="/auctions/<%= l.auction_id %>">Lot <%= l.lot_no %>: <%= l.title %></a><span class="sub"><%= l.auction_title %></span></td>
                    <td class="num" data-label="Your bid"><%= fmtINR(l.my_amount) %><span class="sub">per <%= l.unit %></span></td>
                    <td class="num" data-label="Highest bid"><%= l.top_amount === null ? 'Hidden' : fmtINR(l.top_amount) %></td>
                    <td data-label="Standing"><span class="standing <%= l.leading ? 'lead' : 'out' %>"><%= l.leading ? 'Leading' : 'Outbid' %></span></td>
                    <td data-label="Closes in"><span class="countdown" data-countdown="<%= new Date(l.ends_at).getTime() %>" data-done="Closed"></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
    </div>

    <div>
      <div class="panel">
        <div class="panel-head"><h3>Account</h3><a class="small" href="/account/profile">Edit profile</a></div>
        <div class="panel-body">
          <dl class="kv">
            <dt>Bidder no.</dt><dd><%= bidderNo %></dd>
            <dt>Name</dt><dd><%= user.name %></dd>
            <dt>Email</dt><dd><%= user.email %><% if (!user.email_verified) { %> <span class="tag tag-warn">Not verified</span><% } %></dd>
            <dt>Phone</dt><dd><%= user.phone || 'Not added' %></dd>
            <dt>Documents</dt><dd>
              <% if (user.kyc_status === 'approved') { %><span class="tag tag-ok">Approved</span>
              <% } else if (user.kyc_status === 'pending') { %><span class="tag tag-warn">Under review</span>
              <% } else if (user.kyc_status === 'rejected') { %><span class="tag tag-bad">Not approved</span>
              <% } else { %><span class="tag">Not submitted</span><% } %>
            </dd>
            <% if (fee.enabled) { %>
              <dt>Fee</dt><dd>
                <% if (fee.active) { %><%= fee.until === 'No expiry' ? 'Paid, no expiry' : 'Paid until ' + fee.until %><% if (fee.expiresSoon) { %> <a href="/account/fee">Renew</a><% } %>
                <% } else { %>Not paid <a href="/account/fee">Pay now</a><% } %>
              </dd>
            <% } %>
          </dl>
        </div>
      </div>
      <form class="panel" method="post" action="/account/email-preferences">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="panel-head"><h3>Email preferences</h3></div>
        <div class="panel-body">
          <div class="check">
            <input type="checkbox" id="pref-ann" name="announcements" value="1" <%= user.email_opt_out ? '' : 'checked' %>>
            <div><label for="pref-ann">Email me about new auctions and reminders before they start</label>
            <div class="hint">Outbid alerts, results and receipts are always sent.</div></div>
          </div>
          <button class="btn btn-quiet btn-sm" type="submit">Save preference</button>
        </div>
      </form>
    </div>
  </div>
</div>
