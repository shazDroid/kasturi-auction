<div class="wrap">
  <div class="page-head">
    <h1>Change password</h1>
    <p>Use at least 8 characters. Other devices stay signed in until their session ends.</p>
  </div>
  <%- include('_nav') %>
  <div class="narrow">
    <form class="panel" method="post" action="/account/password" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="panel-body">
        <div class="field">
          <label for="pw-cur">Current password</label>
          <input type="password" id="pw-cur" name="current" autocomplete="current-password" required <%- errors.current ? 'aria-invalid="true"' : '' %>>
          <% if (errors.current) { %><div class="err"><%= errors.current %></div><% } else { %><div class="hint">Forgotten it? <a href="/forgot-password">Reset it by email</a>.</div><% } %>
        </div>
        <div class="field">
          <label for="pw-new">New password</label>
          <input type="password" id="pw-new" name="password" autocomplete="new-password" required minlength="8" <%- errors.password ? 'aria-invalid="true"' : '' %>>
          <% if (errors.password) { %><div class="err"><%= errors.password %></div><% } %>
        </div>
        <div class="field">
          <label for="pw-confirm">Type the new password again</label>
          <input type="password" id="pw-confirm" name="confirm" autocomplete="new-password" required <%- errors.confirm ? 'aria-invalid="true"' : '' %>>
          <% if (errors.confirm) { %><div class="err"><%= errors.confirm %></div><% } %>
        </div>
        <div class="form-actions"><button class="btn" type="submit">Change password</button></div>
      </div>
    </form>
  </div>
</div>
