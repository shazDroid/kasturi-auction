<%# Wordmark. First word of the site name is set heavy, the rest light. %><%
var nm = String((locals.S && S.site_name) || 'Kasturi Auction').trim(); var sp = nm.indexOf(' ');
%><a class="brand has-mark<%= locals.cls ? ' ' + cls : '' %>" href="<%= locals.href || '/' %>"><%- include('mark', { size: locals.size || 30 }) %><span class="brand-word"><b><%= sp > 0 ? nm.slice(0, sp) : nm %></b><% if (sp > 0) { %> <span><%= nm.slice(sp + 1) %></span><% } %></span></a>
