<div class="page-head">
  <div>
    <h1><%= m.subject %></h1>
    <p>To <%= m.to_email %></p>
  </div>
  <div class="row">
    <% if (m.status === 'failed' || m.status === 'skipped') { %>
      <form method="post" action="/admin/emails/log/<%= m.id %>/retry" class="inline-form"><%- include('_csrf') %>
        <button class="btn" type="submit">Send again</button>
      </form>
    <% } %>
    <a class="btn btn-quiet" href="/admin/emails/log">Back to the log</a>
  </div>
</div>

<div class="cols">
  <div class="panel">
    <div class="panel-body">
      <iframe class="mail-preview mail-preview-tall" sandbox title="Email body" src="/admin/emails/log/<%= m.id %>/html"></iframe>
    </div>
  </div>
  <div class="panel">
    <div class="panel-head"><h3>Delivery</h3><%- tag('email', m.status) %></div>
    <div class="panel-body">
      <dl class="kv">
        <dt>Type</dt><dd><%= templateName || (m.template_key === 'broadcast' ? 'Broadcast' : m.template_key === 'admin_message' ? 'Message to a bidder' : m.template_key || 'Other') %></dd>
        <dt>Queued</dt><dd><%= fmtDTs(m.created_at) %></dd>
        <dt>Sent</dt><dd><%= m.sent_at ? fmtDTs(m.sent_at) : 'Not sent' %></dd>
        <dt>Attempts</dt><dd><%= m.attempts %></dd>
        <% if (m.error) { %><dt>Error</dt><dd class="err-cell"><%= m.error %></dd><% } %>
      </dl>
    </div>
  </div>
</div>
