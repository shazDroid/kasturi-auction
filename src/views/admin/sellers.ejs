<div class="page-head">
  <div>
    <h1>Sellers</h1>
    <p>Companies and plants whose material you auction. The seller name is shown on the auction page.</p>
  </div>
  <a class="btn" href="/admin/sellers/new">Add seller</a>
</div>

<form class="filters" method="get" action="/admin/sellers" role="search">
  <label class="sr" for="f-q">Search</label>
  <input type="search" id="f-q" name="q" value="<%= q %>" placeholder="Name, location or contact">
  <button class="btn btn-quiet" type="submit">Search</button>
  <% if (q) { %><a href="/admin/sellers">Clear</a><% } %>
</form>

<div class="table-wrap">
<% if (!rows.length) { %>
  <div class="empty"><% if (q) { %><h3>No sellers match "<%= q %>"</h3><p><a href="/admin/sellers">Show all sellers</a>.</p><% } else { %><h3>No sellers yet</h3><p><a href="/admin/sellers/new">Add the first seller</a> before creating its auctions.</p><% } %></div>
<% } else { %>
  <table class="table table-stack">
    <thead><tr><th>Seller</th><th>Contact</th><th class="num">Auctions</th><th>Last auction</th><th>Status</th><th></th></tr></thead>
    <tbody>
    <% rows.forEach(function (s) { %>
      <tr>
        <td class="cell-main"><a class="primary" href="/admin/sellers/<%= s.id %>/edit"><%= s.name %></a><span class="sub"><%= s.location %></span></td>
        <td data-label="Contact"><%= s.contact_name %><span class="sub"><%= [s.contact_phone, s.contact_email].filter(Boolean).join(', ') %></span></td>
        <td class="num" data-label="Auctions"><%= s.auction_count %></td>
        <td data-label="Last auction"><%= s.last_auction ? fmtDate(s.last_auction) : 'None' %></td>
        <td data-label="Status"><%- s.active ? tag('yesno', true, 'Active') : tag('yesno', false, 'Inactive') %></td>
        <td class="actions"><a href="/admin/auctions/new?seller_id=<%= s.id %>">New auction</a><a href="/admin/sellers/<%= s.id %>/edit">Edit</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
</div>
