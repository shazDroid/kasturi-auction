<%
  var isLive = a.phase === 'live';
  var canAddLots = !a.window_over && a.status !== 'cancelled';
%>
<div class="page-head">
  <div>
    <h1><%= a.title %></h1>
    <p class="row"><%- tag('phase', a.phase) %><% if (a.visibility === 'restricted') { %> <span class="tag tag-warn">Restricted</span><% } %> <span><%= a.seller_name || 'No seller set' %><%= a.location ? ', ' + a.location : '' %></span></p>
  </div>
  <div class="row">
    <a class="btn btn-accent" href="/auctions/<%= a.id %>" target="_blank" rel="noopener">Preview as bidder</a>
    <a class="btn btn-quiet" href="/admin/auctions/<%= a.id %>/edit">Edit auction</a>
    <% if (canAddLots) { %><a class="btn" href="/admin/auctions/<%= a.id %>/lots/new">Add lot</a><% } %>
  </div>
</div>

<% if (a.status === 'draft') { %>
  <div class="notice notice-warn"><p>This auction is a draft and bidders cannot see it.<%= a.lot_count ? ' Publish it when the lots and dates are final.' : ' Add at least one lot, then publish it.' %></p></div>
<% } else if (a.status === 'cancelled') { %>
  <div class="notice notice-error"><p>This auction is cancelled. Bidding is stopped and bidders cannot see it.</p></div>
<% } %>

<% if (aud.previewGroups.length) { %>
<form method="get" action="/auctions/<%= a.id %>" target="_blank" class="filters ax-preview-as">
  <label for="as_group">Preview as group</label>
  <select id="as_group" name="as_group">
    <% aud.previewGroups.forEach(function (g) { %><option value="<%= g.id %>"><%= g.name %></option><% }) %>
  </select>
  <button class="btn btn-quiet btn-sm" type="submit">Open preview</button>
  <span class="muted small">Shows the auction with that group's start prices<%= a.visibility === 'restricted' ? ' and what its members can see' : '' %>.</span>
</form>
<% } %>

<div class="panel">
  <div class="panel-body toolbar">
    <% if (a.status !== 'published' && a.status !== 'cancelled' || (a.status === 'cancelled' && !a.window_over)) { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/publish" class="inline-form"><%- include('_csrf') %>
        <button class="btn btn-accent btn-sm" type="submit" <%= a.lot_count ? '' : 'disabled' %> data-confirm="<%= a.started ? 'Bidding opens immediately because the start time has passed. Publish now?' : 'Publish this auction? Bidders will be able to see it.' %>">Publish auction</button>
      </form>
    <% } %>
    <% if (a.status === 'published' && !a.started) { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/unpublish" class="inline-form"><%- include('_csrf') %>
        <button class="btn btn-quiet btn-sm" type="submit">Move back to draft</button>
      </form>
    <% } %>
    <% if (a.status === 'published' && a.phase !== 'closed') { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/announce" class="inline-form"><%- include('_csrf') %>
        <% var who = aud.mailCount + ' bidder' + (aud.mailCount === 1 ? '' : 's') + (a.visibility === 'restricted' ? ' who can see this restricted auction' : ' with a verified email and announcements turned on'); %>
        <button class="btn btn-quiet btn-sm" type="submit" <%= aud.mailCount ? '' : 'disabled' %> title="<%= aud.mailCount ? 'Sends to ' + who : 'Nobody to email' %>" data-confirm="<%= a.announced_at ? 'This auction was already announced on ' + fmtDT(a.announced_at) + '. Email ' + who + ' again?' : 'Email this auction to ' + who + '?' %>">Email announcement to <%= aud.mailCount %> bidder<%= aud.mailCount === 1 ? '' : 's' %></button>
      </form>
    <% } %>
    <form method="post" action="/admin/auctions/<%= a.id %>/duplicate" class="inline-form"><%- include('_csrf') %>
      <button class="btn btn-quiet btn-sm" type="submit">Duplicate as draft</button>
    </form>
    <a class="btn btn-quiet btn-sm" href="/admin/auctions/<%= a.id %>/bids.csv">Download bids (CSV)</a>
    <a class="btn btn-quiet btn-sm" href="/admin/auctions/<%= a.id %>/results.csv">Download results (CSV)</a>
    <span class="grow"></span>
    <% if (a.status !== 'cancelled') { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/cancel" class="inline-form"><%- include('_csrf') %>
        <button class="btn btn-danger btn-sm" type="submit" data-confirm="Cancel this auction? Bidding stops at once and bidders can no longer see it.">Cancel auction</button>
      </form>
    <% } %>
    <% if (!a.bid_count_all) { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/delete" class="inline-form"><%- include('_csrf') %>
        <button class="btn btn-danger btn-sm" type="submit" data-confirm="Delete this auction and its <%= a.lot_count %> lot(s)? This cannot be undone.">Delete</button>
      </form>
    <% } %>
  </div>
</div>

<div class="panel ax-overview">
  <div class="panel-head"><h3>Summary</h3><span class="muted small">Times are IST</span></div>
  <div class="panel-body ax-overview-body">
    <div class="ax-overview-cover">
      <% if (a.cover_id) { %>
        <a href="/media/<%= a.cover_id %>" target="_blank" rel="noopener"><img src="/media/<%= a.cover_id %>?size=thumb" alt="Cover photo of this auction" width="320" height="240"></a>
        <a class="small" href="/admin/auctions/<%= a.id %>/edit#photos"><%= a.photo_count === 1 ? '1 photo' : a.photo_count + ' photos' %>, manage photos</a>
      <% } else { %>
        <a class="ax-cover-empty" href="/admin/auctions/<%= a.id %>/edit#photos"><span>No photos</span><span class="small">Add them on the edit page</span></a>
      <% } %>
    </div>
    <dl class="kv">
      <dt>Status</dt><dd><%- tag('status', a.status) %></dd>
      <dt>Bidding opens</dt><dd><%= fmtDT(a.starts_at) %></dd>
      <dt>First lot closes</dt><dd><%= fmtDT(a.ends_at) %></dd>
      <dt>Gap between lots</dt><dd><%= a.stagger_min ? a.stagger_min + ' min' : 'All lots close together' %></dd>
      <dt>Auto-extend</dt><dd><%= a.extend_by_min ? 'Bid in last ' + a.extend_window_min + ' min adds ' + a.extend_by_min + ' min' : 'Off' %></dd>
      <dt>Highest bid shown</dt><dd><%= a.show_highest_bid ? 'Yes' : 'No, bidders only see if they lead' %></dd>
      <dt>Auto award</dt><dd><%= a.auto_award ? 'Yes, when reserve is met' : 'No, every lot needs a decision' %></dd>
    </dl>
    <dl class="kv">
      <dt>Category</dt><dd><%= a.category || 'Not set' %></dd>
      <dt>Lots</dt><dd><%= a.lot_count %><%= isLive ? ', ' + a.lots_open + ' still open' : '' %></dd>
      <dt>Bids</dt><dd><%= fmtNum(a.bid_count) %> from <%= a.bidder_count %> bidder<%= a.bidder_count === 1 ? '' : 's' %></dd>
      <dt>Announced</dt><dd><%= a.announced_at ? fmtDT(a.announced_at) : 'Not yet' %></dd>
      <dt>Reminder email</dt><dd><%= a.reminder_sent ? 'Sent' : (S.reminder_minutes_before !== '0' ? 'Sent ' + S.reminder_minutes_before + ' min before start' : 'Turned off in settings') %></dd>
      <dt>Public page</dt><dd><a href="/auctions/<%= a.id %>" target="_blank" rel="noopener"><%= a.status === 'published' ? 'Open auction page' : 'Preview auction page' %></a><% if (a.status !== 'published') { %><span class="sub muted small">Bidders see it after publishing</span><% } %></dd>
      <dt>Who can see it</dt><dd><%= a.visibility === 'restricted' ? 'Restricted, ' + aud.total + ' bidder' + (aud.total === 1 ? '' : 's') : 'Public, all bidders' %> <a class="small" href="#audience">Details</a></dd>
      <dt>Description</dt><dd><%= a.description ? excerpt(a.description, 90) : 'Not written yet' %></dd>
    </dl>
  </div>
</div>

<div class="panel" id="audience">
  <div class="panel-head">
    <h3>Who can see and bid</h3>
    <span class="row"><% if (a.visibility === 'restricted') { %><span class="tag tag-warn">Restricted</span><% } else { %><span class="tag">Public</span><% } %><a class="small" href="/admin/auctions/<%= a.id %>/edit#visibility">Change</a></span>
  </div>
  <div class="panel-body">
    <% if (a.visibility !== 'restricted') { %>
      <p>Every visitor can see this auction and every eligible bidder can bid. <%= aud.total %> registered bidder<%= aud.total === 1 ? '' : 's' %> (not blocked). <%= aud.mailCount %> of them receive announcement emails.</p>
      <% if (aud.invites.length) { %><p class="muted small"><%= aud.invites.length %> bidder<%= aud.invites.length === 1 ? ' is' : 's are' %> on the invited list from when the auction was restricted. The list only applies when it is restricted again.</p><% } %>
    <% } else { %>
      <% if (!aud.total) { %>
        <div class="notice notice-error" role="alert"><p>Nobody can see this auction yet. <%= aud.groups.length ? 'Its groups have no bidders.' : 'It has no groups and no invited bidders.' %> <a href="/admin/auctions/<%= a.id %>/edit#visibility">Tick a group</a> or invite bidders below.</p></div>
      <% } else { %>
        <p><b><%= aud.total %> bidder<%= aud.total === 1 ? '' : 's' %></b> can see this auction: members of its groups plus invited bidders, not counting blocked accounts. <%= aud.mailCount %> of them receive announcement emails.</p>
      <% } %>
      <dl class="kv ax-kv-wide">
        <dt>Groups</dt>
        <dd><% if (!aud.groups.length) { %><span class="muted">None</span><% } else { aud.groups.forEach(function (g, i) { %><%= i ? ', ' : '' %><a href="/admin/groups/<%= g.id %>"><%= g.name %></a> <span class="muted">(<%= g.members %>)</span><% }) } %></dd>
        <dt>Invited bidders</dt><dd><%= aud.invites.length || 'None' %></dd>
      </dl>
    <% } %>

    <% if (a.visibility === 'restricted' || aud.invites.length) { %>
    <h4 class="ax-subhead">Invited bidders</h4>
    <% if (aud.invites.length) { %>
      <div class="table-wrap flat">
        <table class="table table-stack">
          <thead><tr><th>Bidder</th><th>Email</th><th>Group</th><th></th></tr></thead>
          <tbody>
          <% aud.invites.forEach(function (u) { %>
            <tr>
              <td class="cell-main"><a class="primary" href="/admin/bidders/<%= u.id %>"><%= u.company_name || u.name %></a><span class="sub"><%= u.company_name ? u.name + ', ' : '' %><%= bidderNo(u.id) %></span><% if (u.blocked) { %> <span class="tag tag-bad">Blocked</span><% } %></td>
              <td data-label="Email"><%= u.email %></td>
              <td data-label="Group"><%= u.group_name || 'None' %><% if (u.via_group) { %><span class="sub">Can also see it through this group</span><% } %></td>
              <td class="actions">
                <form method="post" action="/admin/auctions/<%= a.id %>/invites/<%= u.id %>/delete" class="inline-form"><%- include('_csrf') %>
                  <button class="linkbtn danger" type="submit" data-confirm="Remove the invitation of <%= u.name %>?">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted small">No bidders are invited individually.</p>
    <% } %>

    <form class="filters mt" method="get" action="/admin/auctions/<%= a.id %>#audience" role="search">
      <label for="invite-q">Invite bidders</label>
      <input type="search" id="invite-q" name="invite_q" value="<%= aud.inviteQ %>" placeholder="Name, company, email or KA number">
      <button class="btn btn-quiet btn-sm" type="submit">Search</button>
      <% if (aud.inviteQ) { %><a href="/admin/auctions/<%= a.id %>#audience">Clear</a><% } %>
    </form>
    <% if (aud.results) { %>
      <% if (!aud.results.length) { %>
        <p class="muted small">No bidders match "<%= aud.inviteQ %>" who are not invited already.</p>
      <% } else { %>
      <form method="post" action="/admin/auctions/<%= a.id %>/invites">
        <%- include('_csrf') %>
        <div class="table-wrap flat">
          <table class="table table-stack">
            <thead><tr><th class="ax-check-cell"><input type="checkbox" data-select-all="user_ids" aria-label="Select all bidders found" hidden></th><th>Bidder</th><th>Email</th><th>Group</th></tr></thead>
            <tbody>
            <% aud.results.slice(0, SEARCH_LIMIT).forEach(function (u) { %>
              <tr>
                <td class="ax-check-cell"><input type="checkbox" name="user_ids" value="<%= u.id %>" id="inv-<%= u.id %>"></td>
                <td class="cell-main"><label for="inv-<%= u.id %>" class="ax-row-label"><b><%= u.company_name || u.name %></b><span class="sub"><%= u.company_name ? u.name + ', ' : '' %><%= bidderNo(u.id) %><%= u.city ? ', ' + u.city : '' %></span></label><% if (u.blocked) { %> <span class="tag tag-bad">Blocked</span><% } %></td>
                <td data-label="Email"><%= u.email %></td>
                <td data-label="Group"><%= u.group_name || 'None' %><% if (u.via_group && a.visibility === 'restricted') { %><span class="sub">Can already see it through this group</span><% } %></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
        <% if (aud.results.length > SEARCH_LIMIT) { %><p class="muted small">Showing the first <%= SEARCH_LIMIT %> matches. Narrow the search to find others.</p><% } %>
        <div class="form-actions mt"><button class="btn btn-sm" type="submit">Invite selected bidders</button></div>
      </form>
      <% } %>
    <% } %>
    <% } %>
  </div>
</div>

<div class="panel" id="documents">
  <div class="panel-head"><h3>Documents</h3><span class="muted small">Inspection reports, lot lists, layout drawings or the full terms, as PDF or image. Up to <%= MAX_DOCS %>.</span></div>
  <div class="panel-body">
    <% if (docs.length) { %>
      <div class="table-wrap flat">
        <table class="table">
          <thead><tr><th>Title</th><th>File</th><th>Added</th><th></th></tr></thead>
          <tbody>
          <% docs.forEach(function (d) { %>
            <tr>
              <td class="cell-main"><a class="primary" href="/media/<%= d.file_id %>" target="_blank" rel="noopener"><%= d.title %></a></td>
              <td><%= d.filename %><span class="sub"><%= d.mime === 'application/pdf' ? 'PDF' : 'Image' %>, <%= fmtSize(d.size) %></span></td>
              <td class="nowrap"><%= fmtDT(d.created_at) %></td>
              <td class="actions">
                <a href="/media/<%= d.file_id %>" target="_blank" rel="noopener">Open</a>
                <form method="post" action="/admin/auctions/<%= a.id %>/documents/<%= d.id %>/delete" class="inline-form"><%- include('_csrf') %>
                  <button class="linkbtn danger" type="submit" data-confirm="Remove &quot;<%= d.title %>&quot;? Bidders will no longer be able to open it.">Remove</button>
                </form>
              </td>
            </tr>
          <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <p class="muted">No documents yet. Bidders see uploaded documents on the auction page once it is published.</p>
    <% } %>
    <% if (docs.length < MAX_DOCS) { %>
    <form method="post" enctype="multipart/form-data" action="/admin/auctions/<%= a.id %>/documents?_csrf=<%= csrf %>" class="ax-doc-form">
      <div class="field">
        <label for="doc-title">Title</label>
        <input type="text" id="doc-title" name="title" maxlength="200" placeholder="For example Inspection report, 18 Nov">
      </div>
      <div class="field">
        <label for="doc-file">File</label>
        <input type="file" id="doc-file" name="file" accept="application/pdf,image/jpeg,image/png,image/webp" required>
      </div>
      <div class="field"><button class="btn btn-sm" type="submit">Upload document</button></div>
    </form>
    <p class="hint muted small">PDF, JPG, PNG or WebP, up to 8 MB. If you leave the title empty, the file name is used.</p>
    <% } %>
  </div>
</div>

<% if (isLive && a.lots_open) { %>
<div class="panel">
  <div class="panel-head"><h3>Live controls</h3><span class="muted small">Bidders see changes at once</span></div>
  <div class="panel-body">
    <form method="post" action="/admin/auctions/<%= a.id %>/extend" class="filters">
      <%- include('_csrf') %>
      <label for="ext-min">Extend closing time by</label>
      <input type="number" id="ext-min" name="minutes" min="1" max="1440" step="1" value="10" class="input-sm" required>
      <span>minutes for</span>
      <label class="sr" for="ext-lot">Lot</label>
      <select id="ext-lot" name="lot_id">
        <option value="">All open lots</option>
        <% lots.filter(function (l) { return l.status === 'open'; }).forEach(function (l) { %><option value="<%= l.id %>">Lot <%= l.lot_no %>: <%= l.title %></option><% }) %>
      </select>
      <button class="btn btn-sm" type="submit" data-confirm="Extend the closing time?">Extend closing time</button>
    </form>
    <p class="hint muted small">To end a lot early, use "Close now" in the lots table. A closed lot cannot be reopened.</p>
  </div>
</div>
<% } %>

<div id="live-region" <% if (isLive) { %>data-live-url="/admin/auctions/<%= a.id %>/live"<% } %>>
  <%- include('_auction_live') %>
</div>
