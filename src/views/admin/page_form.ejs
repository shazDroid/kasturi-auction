<div class="page-head">
  <div>
    <h1>Edit page</h1>
    <p><%= p.title %>, shown at <a href="/<%= p.slug %>" target="_blank" rel="noopener">/<%= p.slug %></a>. Last edited <%= fmtDT(p.updated_at) %>.</p>
  </div>
  <a class="btn btn-quiet" href="/<%= p.slug %>" target="_blank" rel="noopener">View on site</a>
</div>

<% if (Object.keys(errors).length) { %><div class="notice notice-error" role="alert">Check the highlighted fields. The page was not saved.</div><% } %>
<% if (notes.length) { %>
  <div class="notice notice-warn">
    <p>This page contains a hidden note that bidders do not see. It is removed when you save the page:</p>
    <% notes.forEach(function (n) { %><p class="small"><%= n %></p><% }) %>
  </div>
<% } %>

<form method="post" action="/admin/pages/<%= encodeURIComponent(p.slug) %>" class="panel" novalidate>
  <div class="panel-body">
    <%- include('_csrf') %>
    <div class="field mid">
      <label for="title">Page title</label>
      <input type="text" id="title" name="title" value="<%= v.title %>" maxlength="200" required>
      <%- include('_err', { k: 'title' }) %>
    </div>
    <div class="field">
      <label for="body" id="body-label">Page content</label>
      <textarea id="body" name="body" class="code-area code-area-tall" spellcheck="false" data-rich data-rich-source data-rich-tall data-label-id="body-label"><%= v.body %></textarea>
      <%- include('_err', { k: 'body' }) %>
      <div class="hint">The page title is shown above the content, so do not repeat it as a heading. Use "Heading 2" for sections and "Heading 3" below them. Scripts, styles and embedded media are removed when you save.</div>
    </div>
    <div class="form-actions">
      <button class="btn" type="submit">Save page</button>
      <a class="btn btn-quiet" href="/admin/pages">Back to pages</a>
    </div>
  </div>
</form>
