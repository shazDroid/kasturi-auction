<div class="page-head">
  <div>
    <h1>My account</h1>
    <p>Signed in as <%= admin.email %>, <%= admin.role === 'superadmin' ? 'super admin' : 'staff' %>.</p>
  </div>
</div>

<% if (Object.keys(errors).length) { %><div class="notice notice-error" role="alert">Check the highlighted fields. Nothing was saved.</div><% } %>

<form method="post" action="/admin/team/me" class="panel mid" novalidate>
  <div class="panel-body">
    <%- include('_csrf') %>
    <div class="field">
      <label for="name">Your name</label>
      <input type="text" id="name" name="name" value="<%= v.name %>" maxlength="200" required>
      <%- include('_err', { k: 'name' }) %>
    </div>
    <fieldset class="mt">
      <legend>Change password</legend>
      <p class="muted small">Leave these empty to keep your current password.</p>
      <div class="field">
        <label for="current_password">Current password</label>
        <input type="password" id="current_password" name="current_password" autocomplete="current-password">
        <%- include('_err', { k: 'current_password' }) %>
      </div>
      <div class="form-grid">
        <div class="field">
          <label for="new_password">New password</label>
          <input type="password" id="new_password" name="new_password" minlength="8" autocomplete="new-password">
          <%- include('_err', { k: 'new_password' }) %>
          <div class="hint">At least 8 characters.</div>
        </div>
        <div class="field">
          <label for="confirm_password">New password again</label>
          <input type="password" id="confirm_password" name="confirm_password" autocomplete="new-password">
          <%- include('_err', { k: 'confirm_password' }) %>
        </div>
      </div>
    </fieldset>
    <div class="form-actions">
      <button class="btn" type="submit">Save changes</button>
    </div>
  </div>
</form>
