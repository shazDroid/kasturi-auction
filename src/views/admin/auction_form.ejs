<div class="page-head">
  <div>
    <h1><%= auction ? 'Edit auction' : 'New auction' %></h1>
    <p><%= auction ? auction.title : 'Set the details and the bidding window. You add lots on the next screen.' %></p>
  </div>
</div>

<% if (Object.keys(errors).length) { %><div class="notice notice-error" role="alert">Check the highlighted fields. The auction was not saved.</div><% } %>

<div class="ax-with-preview">
<form method="post" enctype="multipart/form-data" novalidate class="ax-main-form" id="auction-form"
      action="<%= auction ? '/admin/auctions/' + auction.id : '/admin/auctions' %>?_csrf=<%= csrf %>">
  <div class="panel">
    <div class="panel-head"><h3>What is being sold</h3></div>
    <div class="panel-body">
      <div class="form-grid">
        <div class="field full">
          <label for="title">Auction title</label>
          <input type="text" id="title" name="title" value="<%= v.title %>" maxlength="200" required>
          <%- include('_err', { k: 'title' }) %>
        </div>
        <div class="field">
          <label for="seller_id">Seller</label>
          <select id="seller_id" name="seller_id">
            <option value="">No seller shown</option>
            <% sellers.forEach(function (s) { %><option value="<%= s.id %>" <%= Number(v.seller_id) === s.id ? 'selected' : '' %>><%= s.name %><%= s.active ? '' : ' (inactive)' %></option><% }) %>
          </select>
          <%- include('_err', { k: 'seller_id' }) %>
          <div class="hint"><a href="/admin/sellers/new">Add a seller</a> if it is not in the list.</div>
        </div>
        <div class="field">
          <label for="category">Category</label>
          <input type="text" id="category" name="category" value="<%= v.category %>" list="categories" maxlength="100" placeholder="For example Ferrous scrap">
          <datalist id="categories"><% categories.forEach(function (c) { %><option value="<%= c %>"><% }) %></datalist>
        </div>
        <div class="field full">
          <label for="location">Material location</label>
          <input type="text" id="location" name="location" value="<%= v.location %>" maxlength="200" placeholder="Plant or yard address, city and state">
        </div>
      </div>
    </div>
  </div>

  <div class="panel" id="photos">
    <div class="panel-head"><h3>Photos</h3><span class="muted small"><%= photos.length %> of <%= MAX_PHOTOS %>. The first photo is the cover on the auction list and at the top of the auction page.</span></div>
    <div class="panel-body">
      <% if (photos.length) { %>
        <ol class="ax-gallery" aria-label="Photos of this auction, in display order">
        <% photos.forEach(function (p, i) { %>
          <li class="ax-photo">
            <a href="/media/<%= p.file_id %>" target="_blank" rel="noopener" class="ax-photo-img"><img src="/media/<%= p.file_id %>?size=thumb" alt="Photo <%= i + 1 %> of this auction" width="320" height="240" loading="lazy"></a>
            <div class="ax-photo-meta">
              <% if (i === 0) { %><span class="tag tag-ok">Cover</span><% } else { %><span class="muted small">Photo <%= i + 1 %></span><% } %>
              <% if (p.width) { %><span class="muted small"><%= p.width %> x <%= p.height %></span><% } %>
            </div>
            <div class="ax-photo-actions">
              <% if (i > 0) { %><button class="linkbtn" type="submit" form="aph-<%= p.id %>" name="op" value="cover">Make cover</button><% } %>
              <% if (i > 0) { %><button class="linkbtn" type="submit" form="aph-<%= p.id %>" name="op" value="left" aria-label="Move photo <%= i + 1 %> left">Move left</button><% } %>
              <% if (i < photos.length - 1) { %><button class="linkbtn" type="submit" form="aph-<%= p.id %>" name="op" value="right" aria-label="Move photo <%= i + 1 %> right">Move right</button><% } %>
              <button class="linkbtn danger" type="submit" form="aph-<%= p.id %>" name="op" value="remove" data-confirm="Remove photo <%= i + 1 %>? It is deleted and cannot be restored.">Remove</button>
            </div>
          </li>
        <% }) %>
        </ol>
        <p class="hint muted small">Changes to photos are saved at once. Save other edits on this page first.</p>
      <% } %>
      <% if (photos.length < MAX_PHOTOS) { %>
      <div class="field">
        <label for="images"><%= photos.length ? 'Add more photos' : 'Add photos' %></label>
        <input type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/webp" data-preview="images-preview" data-max-files="<%= MAX_PHOTOS - photos.length %>" data-max-what="auction" aria-describedby="images-hint<%= errors.images ? ' err-images' : '' %>">
        <%- include('_err', { k: 'images' }) %>
        <div class="hint" id="images-hint">JPG, PNG or WebP, up to 8 MB each. You can add <%= MAX_PHOTOS - photos.length %> more. <%= photos.length ? 'They are added after the existing photos.' : 'The first one becomes the cover.' %> A wide photo of the heap or the yard works best; covers are cropped in lists.<% if (Object.keys(errors).length) { %> If you had chosen photos, choose them again.<% } %></div>
        <div class="ax-previews" id="images-preview" aria-live="polite"></div>
      </div>
      <% if (auction) { %><input type="hidden" name="to_photos" value="1"><% } %>
      <% } else { %>
        <%- include('_err', { k: 'images' }) %>
        <p class="muted small">This auction has the maximum of <%= MAX_PHOTOS %> photos. Remove one to add another.</p>
      <% } %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Description, inspection and terms</h3><span class="muted small">Shown to bidders on the auction page</span></div>
    <div class="panel-body">
      <div class="field">
        <label for="description" id="description-label">Description</label>
        <textarea id="description" name="description" rows="8" data-rich data-label-id="description-label" data-placeholder="What is on sale, where it comes from and how it is stored"><%= v.description %></textarea>
        <%- include('_err', { k: 'description' }) %>
        <div class="hint">Use headings and lists to make long descriptions easy to scan. Lot details go on each lot.</div>
      </div>
      <div class="field">
        <label for="inspection" id="inspection-label">Inspection details</label>
        <textarea id="inspection" name="inspection" rows="5" data-rich data-label-id="inspection-label" data-placeholder="Dates, timings, contact person and what to bring"><%= v.inspection %></textarea>
        <%- include('_err', { k: 'inspection' }) %>
      </div>
      <div class="field">
        <label for="terms" id="terms-label">Terms and conditions for this auction</label>
        <textarea id="terms" name="terms" rows="8" data-rich data-label-id="terms-label" data-placeholder="Payment terms, EMD, lifting period, GST and TCS, weighment"><%= v.terms %></textarea>
        <%- include('_err', { k: 'terms' }) %>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Bidding window</h3></div>
    <div class="panel-body">
      <% if (locked) { %>
        <div class="notice notice-warn">Bidding has started, so the start and closing times cannot be changed here. To give bidders more time, use "Extend closing time" on the auction page.</div>
        <dl class="kv">
          <dt>Started</dt><dd><%= fmtDT(auction.starts_at) %> IST</dd>
          <dt>Scheduled close</dt><dd><%= fmtDT(auction.ends_at) %> IST</dd>
        </dl>
      <% } else { %>
      <div class="form-grid three">
        <div class="field">
          <label for="starts_at">Bidding opens (IST)</label>
          <input type="datetime-local" id="starts_at" name="starts_at" value="<%= toLocalInput(v.starts_at) %>" required>
          <%- include('_err', { k: 'starts_at' }) %>
        </div>
        <div class="field">
          <label for="ends_at">First lot closes (IST)</label>
          <input type="datetime-local" id="ends_at" name="ends_at" value="<%= toLocalInput(v.ends_at) %>" required>
          <%- include('_err', { k: 'ends_at' }) %>
        </div>
        <div class="field">
          <label for="stagger_min">Gap between lot closings (minutes)</label>
          <input type="number" id="stagger_min" name="stagger_min" value="<%= v.stagger_min %>" min="0" max="240" step="1">
          <%- include('_err', { k: 'stagger_min' }) %>
          <div class="hint">0 closes all lots together. 5 closes lot 2 five minutes after lot 1, and so on.</div>
        </div>
      </div>
      <% } %>
      <div class="form-grid three">
        <div class="field">
          <label for="extend_window_min">Auto-extend window (minutes)</label>
          <input type="number" id="extend_window_min" name="extend_window_min" value="<%= v.extend_window_min %>" min="0" max="120" step="1">
          <%- include('_err', { k: 'extend_window_min' }) %>
          <div class="hint">A bid this close to a lot's closing time extends that lot.</div>
        </div>
        <div class="field">
          <label for="extend_by_min">Extend by (minutes)</label>
          <input type="number" id="extend_by_min" name="extend_by_min" value="<%= v.extend_by_min %>" min="0" max="120" step="1">
          <%- include('_err', { k: 'extend_by_min' }) %>
          <div class="hint">0 turns auto-extension off for this auction.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="panel" id="visibility">
    <div class="panel-head"><h3>Who can see and bid</h3></div>
    <div class="panel-body">
      <fieldset class="ax-radios">
        <legend class="sr">Who can see and bid</legend>
        <div class="check">
          <input type="radio" id="vis-public" name="visibility" value="public" <%= v.visibility !== 'restricted' ? 'checked' : '' %>>
          <div><label for="vis-public">Public</label><div class="hint">Every visitor can see the auction. Every eligible bidder can bid.</div></div>
        </div>
        <div class="check">
          <input type="radio" id="vis-restricted" name="visibility" value="restricted" <%= v.visibility === 'restricted' ? 'checked' : '' %>>
          <div><label for="vis-restricted">Restricted</label><div class="hint">Only bidders in the groups ticked below, and bidders you invite on the auction page, can see it and bid. Visitors and other bidders do not see it at all.</div></div>
        </div>
      </fieldset>
      <div class="ax-groups-pick" data-show-for="restricted">
        <% if (!groups.length) { %>
          <p class="muted small">There are no bidder groups yet. <a href="/admin/groups/new">Create a group</a>, or save the auction and invite bidders one by one on the auction page.</p>
        <% } else { %>
          <fieldset>
            <legend class="ax-legend">Bidder groups that can see it</legend>
            <div class="ax-checklist">
            <% groups.forEach(function (g) { %>
              <div class="check"><input type="checkbox" id="grp-<%= g.id %>" name="group_ids" value="<%= g.id %>" <%= (v.group_ids || []).map(Number).indexOf(g.id) >= 0 ? 'checked' : '' %>><label for="grp-<%= g.id %>"><%= g.name %></label></div>
            <% }) %>
            </div>
          </fieldset>
          <%- include('_err', { k: 'group_ids' }) %>
        <% } %>
        <% var invites = auction ? auction.invite_count : 0; %>
        <p class="hint muted small"><%= auction ? (invites ? invites + ' bidder' + (invites === 1 ? ' is' : 's are') + ' invited individually.' : 'No bidders are invited individually.') + ' Manage invited bidders on the auction page.' : 'After saving, you can also invite individual bidders on the auction page.' %></p>
        <div class="notice notice-warn ax-nobody" data-nobody data-invites="<%= invites %>" <%= v.visibility === 'restricted' && !(v.group_ids || []).length && !invites ? '' : 'hidden' %>><p>Nobody can see this auction yet. Tick a group, or save and invite bidders on the auction page.</p></div>
      </div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Rules and status</h3></div>
    <div class="panel-body">
      <div class="check">
        <input type="checkbox" id="show_highest_bid" name="show_highest_bid" value="1" <%= v.show_highest_bid ? 'checked' : '' %>>
        <div><label for="show_highest_bid">Show the highest bid to bidders</label><div class="hint">When off, bidders only see whether they are leading (sealed-style bidding).</div></div>
      </div>
      <div class="check">
        <input type="checkbox" id="auto_award" name="auto_award" value="1" <%= v.auto_award ? 'checked' : '' %>>
        <div><label for="auto_award">Award automatically when the reserve price is met</label><div class="hint">The winner is emailed as soon as the lot closes. Lots below reserve still wait for a decision.</div></div>
      </div>
      <div class="field field-narrow">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="draft" <%= v.status === 'draft' ? 'selected' : '' %>>Draft (hidden from bidders)</option>
          <option value="published" <%= v.status === 'published' ? 'selected' : '' %>>Published</option>
          <% if (auction) { %><option value="cancelled" <%= v.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option><% } %>
        </select>
        <%- include('_err', { k: 'status' }) %>
      </div>
    </div>
  </div>

  <div class="form-actions mt">
    <button class="btn" type="submit">Save auction</button>
    <button class="btn btn-quiet" type="submit" name="preview" value="1">Save and preview</button>
    <a class="btn btn-quiet" href="<%= auction ? '/admin/auctions/' + auction.id : '/admin/auctions' %>">Cancel</a>
  </div>
</form>

<aside class="ax-live-preview" aria-label="Preview of the auction card" data-card-preview
       data-cover="<%= v.cover_id ? '/media/' + v.cover_id + '?size=thumb' : '' %>"
       data-starts="<%= v.starts_at ? new Date(v.starts_at).toISOString() : '' %>" data-ends="<%= v.ends_at ? new Date(v.ends_at).toISOString() : '' %>"
       data-lots="<%= auction ? auction.lot_count : 0 %>">
  <div class="ax-live-preview-head"><h2>Preview</h2><span class="muted small">The card on the public auction list</span></div>
  <article class="a-card ax-card-preview" aria-hidden="true">
    <div class="media">
      <div class="badges"><span class="tag tag-upcoming" data-pv="phase">Upcoming</span><span class="tag tag-warn" data-pv="restricted" hidden>Restricted</span></div>
      <img data-pv="img" alt="" width="640" height="400" <%- v.cover_id ? 'src="/media/' + v.cover_id + '?size=thumb"' : 'hidden' %>>
      <div data-pv="ph" <%= v.cover_id ? 'hidden' : '' %>><%- include('../partials/ph', { category: v.category, sub: 'No photo yet' }) %></div>
    </div>
    <div class="body">
      <div class="cat" data-pv="category-row" <%= v.category ? '' : 'hidden' %>><span data-pv="category"><%= v.category %></span></div>
      <h3><span data-pv="title"><%= v.title || 'Auction title' %></span></h3>
      <ul class="meta">
        <li data-pv="seller-row"><%- include('../partials/icon', { name: 'factory', size: 17 }) %><span data-pv="seller"></span></li>
        <li data-pv="location-row"><%- include('../partials/icon', { name: 'pin', size: 17 }) %><span data-pv="location"><%= v.location %></span></li>
        <li><%- include('../partials/icon', { name: 'calendar', size: 17 }) %><span class="tnum" data-pv="when"></span></li>
        <li><%- include('../partials/icon', { name: 'package', size: 17 }) %><span data-pv="lots"></span></li>
      </ul>
    </div>
    <div class="foot">
      <div class="when"><span data-pv="foot-label">Starts</span><b class="tnum" data-pv="foot-value"></b></div>
      <span class="btn btn-sm btn-quiet" data-pv="foot-btn">View lots</span>
    </div>
  </article>
  <p class="hint muted small" data-pv="note">Updates as you type. Times are IST.</p>
</aside>
</div>

<% if (auction) { photos.forEach(function (p) { %><form id="aph-<%= p.id %>" method="post" action="/admin/auctions/<%= auction.id %>/photos/<%= p.id %>" class="hide"><%- include('_csrf') %></form>
<% }) } %>
