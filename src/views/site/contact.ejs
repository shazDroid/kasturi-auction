<div class="wrap">
  <div class="page-head">
    <h1>Contact us</h1>
    <p>Questions about an auction, your account or selling material through us. We reply within one working day.</p>
  </div>
  <div class="cols">
    <div>
      <% if (formError) { %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
      <% if (Object.keys(errors).length) { %><div class="notice notice-error" role="alert">Some details need fixing. Check the fields marked below.</div><% } %>
      <form class="panel" method="post" action="/contact" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="panel-body">
          <div class="form-grid">
            <div class="field">
              <label for="c-name">Your name</label>
              <input type="text" id="c-name" name="name" value="<%= values.name %>" maxlength="100" autocomplete="name" required <%- errors.name ? 'aria-invalid="true"' : '' %>>
              <% if (errors.name) { %><div class="err"><%= errors.name %></div><% } %>
            </div>
            <div class="field">
              <label for="c-company">Company <span class="muted">(optional)</span></label>
              <input type="text" id="c-company" name="company" value="<%= values.company %>" maxlength="150" autocomplete="organization">
            </div>
            <div class="field">
              <label for="c-email">Email</label>
              <input type="email" id="c-email" name="email" value="<%= values.email %>" maxlength="200" autocomplete="email" required <%- errors.email ? 'aria-invalid="true"' : '' %>>
              <% if (errors.email) { %><div class="err"><%= errors.email %></div><% } %>
            </div>
            <div class="field">
              <label for="c-phone">Phone <span class="muted">(optional)</span></label>
              <input type="tel" id="c-phone" name="phone" value="<%= values.phone %>" maxlength="20" autocomplete="tel" <%- errors.phone ? 'aria-invalid="true"' : '' %>>
              <% if (errors.phone) { %><div class="err"><%= errors.phone %></div><% } %>
            </div>
            <div class="field full">
              <label for="c-message">Message</label>
              <textarea id="c-message" name="message" maxlength="4000" rows="6" required <%- errors.message ? 'aria-invalid="true"' : '' %>><%= values.message %></textarea>
              <% if (errors.message) { %><div class="err"><%= errors.message %></div><% } else { %><div class="hint">If you are selling, tell us the material, approximate quantity and where it is.</div><% } %>
            </div>
            <div class="hp" aria-hidden="true">
              <label for="c-website">Leave this field empty</label>
              <input type="text" id="c-website" name="website" tabindex="-1" autocomplete="off">
            </div>
          </div>
          <div class="form-actions"><button class="btn" type="submit">Send message</button></div>
        </div>
      </form>
    </div>
    <aside>
      <div class="panel">
        <div class="panel-head"><h3><%= S.site_name %></h3></div>
        <div class="panel-body">
          <dl class="kv">
            <dt>Email</dt><dd><a href="mailto:<%= S.contact_email %>"><%= S.contact_email %></a></dd>
            <% if (S.contact_phone) { %><dt>Phone</dt><dd><a href="tel:<%= S.contact_phone.replace(/[^\d+]/g, '') %>"><%= S.contact_phone %></a></dd><% } %>
            <% if (S.support_hours) { %><dt>Hours</dt><dd><%= S.support_hours %></dd><% } %>
            <% if (S.contact_address) { %><dt>Office</dt><dd><%- nl2p(S.contact_address) %></dd><% } %>
          </dl>
        </div>
      </div>
      <% if (user) { %><p class="muted small section">Quote your bidder number, <%= bidderNo(user.id) %>, in the message so we can find your account quickly.</p><% } %>
    </aside>
  </div>
</div>
