<section class="auth">
  <div class="wrap">
    <div class="auth-card">
      <div class="ac-body">
        <div class="ac-mark"><%- include('../partials/mark', { size: 40 }) %></div>
        <h1>Reset your password</h1>
        <p class="ac-lead">Enter the email you registered with. We will send you a link to choose a new password.</p>
        <%- include('../partials/flash') %>
        <% if (formError) { %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
        <form method="post" action="/forgot-password" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="f-email">Email</label>
            <input type="email" id="f-email" name="email" value="<%= values.email %>" autocomplete="email" required <%- errors.email ? 'aria-invalid="true"' : '' %>>
            <% if (errors.email) { %><div class="err"><%= errors.email %></div><% } %>
          </div>
          <div class="form-actions"><button class="btn btn-block btn-lg" type="submit">Send reset link</button></div>
        </form>
      </div>
      <div class="ac-foot">Remembered it? <a href="/login">Back to sign in</a></div>
    </div>
  </div>
</section>
