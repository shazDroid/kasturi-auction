<div class="wrap narrow">
  <div class="page-head">
    <h1>Reset your password</h1>
    <p>Enter the email you registered with. We will send you a link to choose a new password.</p>
  </div>
  <% if (formError) { %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
  <form class="panel" method="post" action="/forgot-password" novalidate>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="panel-body">
      <div class="field">
        <label for="f-email">Email</label>
        <input type="email" id="f-email" name="email" value="<%= values.email %>" autocomplete="email" required <%- errors.email ? 'aria-invalid="true"' : '' %>>
        <% if (errors.email) { %><div class="err"><%= errors.email %></div><% } %>
      </div>
      <div class="form-actions"><button class="btn" type="submit">Send reset link</button> <a href="/login">Back to sign in</a></div>
    </div>
  </form>
</div>
