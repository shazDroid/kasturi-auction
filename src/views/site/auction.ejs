<%
  var a = auction;
  var phase = a.phase;
  var live = phase === 'live';
  var upcoming = phase === 'upcoming';
  var plural = function (n, word) { return n + ' ' + word + (n === 1 ? '' : 's'); };
  var I = function (n, size) { return include('../partials/icon', { name: n, size: size || 18 }); };
  var loginHref = '/login?next=' + encodeURIComponent('/auctions/' + a.id);
  var pq = previewQuery || '';
  var disabledAttr = preview ? 'disabled' : '';
  var hasAbout = !!rich(a.description), hasInsp = !!rich(a.inspection), hasTerms = !!rich(a.terms);
  function kb(n) { return n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB'; }

  // Result text for a closed lot. Kept in step with resultFor() in public/js/room.js.
  function resultFor(l) {
    if (l.result === 'awarded') return l.won ? ['Awarded to you', 'tag-ok'] : ['Sold', ''];
    if (l.result === 'pending') return ['Awaiting seller decision', 'tag-warn'];
    if (l.result === 'rejected') return ['Not sold', ''];
    if (l.result === 'no_bids') return ['No bids', ''];
    return ['Closed', ''];
  }
  function rowClass(l) {
    if (!user || l.myBid === null || l.myBid === undefined) return '';
    if (l.status === 'closed') return l.won ? 'leading' : '';
    return l.leading ? 'leading' : 'outbid';
  }
%>
<div data-server-now="<%= serverNow %>">
  <section class="a-hero on-dark">
    <div class="wrap">
      <ol class="crumbs"><li><a href="/">Home</a></li><li><a href="/auctions">Auctions</a></li><% if (a.category) { %><li><a href="/auctions?category=<%= encodeURIComponent(a.category) %>"><%= a.category %></a></li><% } %><li><span aria-current="page">Auction <%= a.id %></span></li></ol>
      <div class="a-hero-grid">
        <div>
          <div class="row auction-tags">
            <% if (live) { %><span class="tag tag-live">Live</span><% } else if (upcoming) { %><span class="tag tag-upcoming">Upcoming</span><% } else { %><span class="tag tag-dark">Closed</span><% } %>
            <% if (a.category) { %><span class="tag tag-dark"><%- include('../partials/cat_icon', { category: a.category, size: 14 }) %><%= a.category %></span><% } %>
            <% if (a.visibility === 'restricted') { %><span class="tag tag-dark">Invitation only</span><% } %>
          </div>
          <h1><%= a.title %></h1>
          <% if (a.seller_name) { %>
            <div class="seller">
              <% if (a.seller_logo) { %><img src="/media/<%= a.seller_logo %>" alt="" width="40" height="40"><% } else { %><span class="s-ico"><%- I('factory', 20) %></span><% } %>
              <div><span>Listed by</span><b><%= a.seller_name %></b></div>
            </div>
          <% } %>
          <div class="a-facts">
            <% if (live) { %><div><%- I('timer') %><div><span>Last lot closes in</span><b class="countdown" data-countdown="<%= lastClose %>" data-last-close data-done="Closing"></b></div></div>
            <% } else if (upcoming) { %><div><%- I('timer') %><div><span>Bidding opens in</span><b class="countdown" data-countdown="<%= new Date(a.starts_at).getTime() %>" data-done="Starting"></b></div></div><% } %>
            <div><%- I('calendar') %><div><span><%= live || !upcoming ? 'Started' : 'Starts' %></span><b><%= fmtDate(a.starts_at).replace(/ \d{4}$/, "") %>, <%= fmtTime(a.starts_at) %></b></div></div>
            <div><%- I('clock') %><div><span><%= phase === 'closed' ? 'Closed' : (a.stagger_min > 0 ? 'First lot closes' : 'Ends') %></span><% var endD = phase === 'closed' ? lastClose : a.ends_at; %><b><%= fmtDate(endD).replace(/ \d{4}$/, '') %>, <%= fmtTime(endD) %></b></div></div>
            <% if (a.location) { %><div><%- I('pin') %><div><span>Material at</span><b><%= a.location %></b></div></div><% } %>
          </div>
          <% if (!preview && phase !== 'closed') { %>
            <div class="a-actions"><%- include('../partials/watch', { auctionId: a.id, watching: watching, dark: true }) %></div>
          <% } %>
        </div>
        <% if (images.length) { %>
          <div class="a-media" data-gallery>
            <button type="button" class="a-cover js-gallery-open" aria-label="Open photo 1 of <%= images.length %> full screen">
              <img class="js-gallery-img" src="/media/<%= images[0].file_id %>" alt="<%= a.title %>, photo 1 of <%= images.length %>" width="<%= images[0].width || 800 %>" height="<%= images[0].height || 500 %>">
              <span class="zoom"><%- I('expand', 15) %><%= images.length > 1 ? 'View all ' + images.length + ' photos' : 'View full screen' %></span>
            </button>
            <% if (images.length > 1) { %>
              <div class="gallery-thumbs" role="group" aria-label="Auction photos">
                <% images.forEach(function (im, i) { %>
                  <button type="button" data-index="<%= i %>" data-full="/media/<%= im.file_id %>" data-w="<%= im.width || '' %>" data-h="<%= im.height || '' %>" aria-label="Show photo <%= i + 1 %> of <%= images.length %>" aria-current="<%= i === 0 ? 'true' : 'false' %>">
                    <img src="/media/<%= im.file_id %>?size=thumb" alt="" loading="lazy" width="160" height="120">
                  </button>
                <% }) %>
              </div>
            <% } else { %>
              <span class="hide" data-index="0" data-full="/media/<%= images[0].file_id %>"></span>
            <% } %>
            <dialog class="lightbox" aria-label="Auction photos">
              <div class="lb-top"><span class="js-lb-count">Photo 1 of <%= images.length %></span><button type="button" class="lb-btn js-lb-close" aria-label="Close"><%- I('close', 22) %></button></div>
              <div class="lb-stage">
                <button type="button" class="lb-btn js-lb-prev" aria-label="Previous photo" <%= images.length < 2 ? 'hidden' : '' %>><%- I('chevron-left', 24) %></button>
                <img class="js-lb-img" src="" alt="">
                <button type="button" class="lb-btn js-lb-next" aria-label="Next photo" <%= images.length < 2 ? 'hidden' : '' %>><%- I('chevron-right', 24) %></button>
              </div>
              <div class="lb-cap"><%= a.title %>. Use the arrow keys to move between photos and Escape to close.</div>
            </dialog>
          </div>
        <% } else { %>
          <div class="a-cover">
            <%- include('../partials/ph', { category: a.category, sub: canSeeLots ? plural(lots.length, 'lot') + ' in this auction' : (a.location || '') }) %>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <div class="subnav">
    <div class="wrap">
      <nav aria-label="On this page">
        <a href="#catalogue" class="active"><%- I('package', 17) %>Lots<% if (canSeeLots) { %> <span class="count-pill"><%= lots.length %></span><% } %></a>
        <% if (hasAbout) { %><a href="#about">About</a><% } %>
        <% if (hasInsp) { %><a href="#inspection">Inspection</a><% } %>
        <% if (hasTerms) { %><a href="#terms">Terms</a><% } %>
        <a href="#schedule">Schedule</a>
        <% if (documents.length) { %><a href="#documents">Documents <span class="count-pill"><%= documents.length %></span></a><% } %>
      </nav>
      <div class="sub-cta">
        <% if (preview) { %><span class="tag tag-warn">Preview</span>
        <% } else if (!user && phase !== 'closed') { %><a class="btn btn-accent btn-sm" href="<%= S.registration_open === '1' ? '/register' : loginHref %>"><%= S.registration_open === '1' ? 'Register to bid' : 'Sign in to bid' %></a>
        <% } else if (user && phase !== 'closed') { %><span><%= bidderNo(user.id) %></span><% if (eligibility.ok) { %><span class="tag tag-ok">Cleared to bid</span><% } else { %><a class="tag tag-warn" href="/account">Complete registration</a><% } %><% } %>
      </div>
    </div>
  </div>

  <div class="wrap">
    <div class="cols room-cols">
      <div class="room-main">
        <section id="catalogue" class="a-section" style="margin-top:0">
          <% if (!canSeeLots) { %>
            <div class="panel">
              <div class="empty">
                <div class="empty-ico"><%- I('package', 24) %></div>
                <h3>Sign in to see the lots</h3>
                <p>Lot details, quantities and prices are shown to registered bidders only.</p>
                <div class="form-actions" style="justify-content:center">
                  <a class="btn" href="<%= loginHref %>">Sign in</a>
                  <% if (S.registration_open === '1') { %><a class="btn btn-quiet" href="/register">Register to bid</a><% } %>
                </div>
              </div>
            </div>
          <% } else { %>
            <% if (live || upcoming) { %>
              <div class="room-bar" id="room-bar">
                <% if (live) { %>
                  <div class="item"><span>Auction</span><b id="rb-phase">Live</b></div>
                  <div class="item"><span>Last lot closes in</span><b class="countdown" id="rb-last" data-countdown="<%= lastClose %>" data-done="Closing"></b></div>
                <% } else { %>
                  <div class="item"><span>Bidding starts in</span><b class="countdown" data-countdown="<%= state.startsAt %>" data-done="Starting"></b></div>
                <% } %>
                <div class="item"><span>Server time, IST</span><b id="rb-clock"><%= fmtTime(new Date(serverNow)) %></b></div>
                <div class="item"><span>Lots open</span><b id="rb-open"><%= openCount %> of <%= lots.length %></b></div>
                <% if (user) { %><div class="item"><span>You are leading</span><b id="rb-leading"><%= plural(leadingCount, 'lot') %></b></div><% } %>
                <div class="conn" id="rb-conn"><span class="dot" aria-hidden="true"></span><span id="rb-conn-text">Connecting</span></div>
              </div>
            <% } %>

            <% if (!lots.length) { %>
              <div class="panel"><div class="empty"><div class="empty-ico"><%- I('package', 24) %></div><h3>No lots listed yet</h3><p>The seller is still preparing this catalogue. Check back before the auction starts.</p></div></div>
            <% } else { %>
              <div class="lot-list" id="lots" data-room
                   data-auction="<%= a.id %>" data-phase="<%= phase %>" data-starts="<%= state.startsAt %>"
                   data-user="<%= user ? 1 : 0 %>" data-can-bid="<%= canBid ? 1 : 0 %>"<% if (pq) { %> data-state-url="/auctions/<%= a.id %>/state<%= pq %>"<% } %>>
                <% lots.forEach(function (l) { var open = l.status === 'open'; var r = resultFor(l); var href = '/auctions/' + a.id + '/lots/' + l.id + pq; %>
                  <article class="lot-row <%= rowClass(l) %>" data-lot="<%= l.id %>" data-lot-no="<%= l.lot_no %>" data-unit="<%= l.unit %>" data-status="<%= l.status %>" data-ends="<%= l.endsAt %>" aria-labelledby="lt-<%= l.id %>">
                    <a class="lr-media" href="<%= href %>" tabindex="-1" aria-hidden="true">
                      <% if (l.cover_file) { %><img src="/media/<%= l.cover_file %>?size=thumb" alt="" loading="lazy" width="320" height="240"><% } else { %><%- include('../partials/ph', { category: a.category, small: true, iconSize: 30 }) %><% } %>
                      <% if (l.photo_count > 1) { %><span class="photos"><%- I('image', 13) %><%= l.photo_count %></span><% } %>
                    </a>
                    <div class="lr-main">
                      <div class="lr-top"><span class="lot-no-chip">Lot <%= l.lot_no %></span><span class="lot-qty"><%- I('scale', 15) %><%= fmtNum(l.quantity) %> <%= l.unit %></span></div>
                      <h3 class="lr-title" id="lt-<%= l.id %>"><a href="<%= href %>"><%= l.title %></a></h3>
                      <% if (l.description) { %><p class="lr-desc"><%= excerpt(l.description, 180) %></p><% } %>
                      <div class="lr-figs">
                        <div><span class="lbl">Start price</span><span class="val"><%= fmtINR(l.startPrice) %></span><span class="sub">per <%= l.unit %></span></div>
                        <div class="js-high"><span class="lbl">Highest bid</span><div>
                          <% if (l.highest !== null && l.highest !== undefined) { %><span class="price"><%= fmtINR(l.highest) %></span>
                          <% } else if (l.bids > 0) { %><span class="muted">Hidden</span>
                          <% } else { %><span class="muted">No bids yet</span><% } %>
                          <span class="sub"><%= plural(l.bids, 'bid') %></span>
                        </div></div>
                        <div class="js-close"><span class="lbl"><%= live && open ? 'Closes in' : open ? 'Closes' : 'Closed' %></span><div>
                          <% if (open && live) { %>
                            <span class="countdown" data-countdown="<%= l.endsAt %>" data-done="Closing"></span>
                            <span class="sub">at <%= fmtTime(new Date(l.endsAt)) %></span>
                          <% } else if (open) { %>
                            <span class="val nowrap"><%= fmtTime(new Date(l.endsAt)) %></span><span class="sub"><%= fmtDate(new Date(l.endsAt)) %></span>
                          <% } else { %>
                            <span class="val"><%= fmtDate(new Date(l.endsAt)) %></span><span class="sub"><%= fmtTime(new Date(l.endsAt)) %></span>
                          <% } %>
                        </div></div>
                      </div>
                    </div>
                    <div class="lr-bid">
                      <div class="js-standing standing <%= !l.myBid ? '' : !open ? 'done' : l.leading ? 'lead' : 'out' %>"><%
                        if (user && l.myBid) {
                          if (!open) { %>Your highest bid <%= fmtINR(l.myBid) %><% }
                          else if (l.leading) { %>Leading with <%= fmtINR(l.myBid) %><% }
                          else { %>Outbid. Your bid <%= fmtINR(l.myBid) %><% }
                        } %></div>
                      <% if (user && autoBid) { %><div class="js-abnote ab-note small<%= open && l.myMax ? '' : ' hide' %>">Auto-bid up to <b class="js-abmax"><%= l.myMax ? fmtINR(l.myMax) : '' %></b>. <a href="<%= href %>#autobid">Change<span class="sr"> auto-bid for lot <%= l.lot_no %></span></a></div><% } %>
                      <div class="js-action">
                        <% if (!open) { %>
                          <span class="tag <%= r[1] %>"><%= r[0] %></span>
                        <% } else if (upcoming && !preview) { %>
                          <span class="muted small">Bidding opens <%= fmtTime(a.starts_at) %>, <%= fmtDate(a.starts_at) %></span>
                        <% } else if (canBid || preview) { %>
                          <form class="bid-form" method="post" action="/lots/<%= l.id %>/bid" data-lot="<%= l.id %>">
                            <input type="hidden" name="_csrf" value="<%= csrf %>">
                            <label class="sr" for="bid-<%= l.id %>">Bid for lot <%= l.lot_no %>, rupees per <%= l.unit %></label>
                            <input type="number" id="bid-<%= l.id %>" name="amount" inputmode="decimal" step="any" min="0" value="<%= l.minBid %>" autocomplete="off" <%= disabledAttr %>>
                            <button class="btn btn-accent" type="submit" <%= disabledAttr %>>Place bid</button>
                          </form>
                          <div class="bid-confirm hide" role="group" aria-label="Confirm your bid"></div>
                          <div class="bid-msg" aria-live="polite" data-min="<%= l.minBid %>"<% if (preview) { %> data-hold="1"<% } %>><%= preview ? 'Preview: bidding is disabled. Minimum ' + fmtINR(l.minBid) : 'Minimum ' + fmtINR(l.minBid) + ' per ' + l.unit %></div>
                        <% } else if (user) { %>
                          <a class="small" href="/account">Complete your registration to bid</a>
                        <% } else { %>
                          <a class="btn btn-quiet btn-sm" href="<%= loginHref %>">Sign in to bid</a>
                        <% } %>
                      </div>
                      <a class="lr-link" href="<%= href %>">View lot details<span class="sr">, lot <%= l.lot_no %></span><%- I('chevron-right', 15) %></a>
                    </div>
                  </article>
                <% }) %>
              </div>
              <p class="muted small table-note">Prices are per unit, excluding GST and other charges listed in the terms. <% if (!a.show_highest_bid) { %>In this auction the highest bid is hidden; you see only whether you are leading.<% } %></p>
            <% } %>
          <% } %>
        </section>

        <% if (hasAbout) { %>
          <section class="a-section" id="about"><h2><%- I('info', 22) %>About this auction</h2><div class="panel"><div class="panel-body"><div class="rich"><%- rich(a.description) %></div></div></div></section>
        <% } %>
        <% if (hasInsp) { %>
          <section class="a-section" id="inspection"><h2><%- I('eye', 22) %>Inspection</h2><div class="panel"><div class="panel-body"><div class="rich"><%- rich(a.inspection) %></div></div></div></section>
        <% } %>
        <% if (hasTerms) { %>
          <section class="a-section" id="terms"><h2><%- I('doc', 22) %>Terms of sale</h2><div class="panel"><div class="panel-body"><div class="rich"><%- rich(a.terms) %></div></div></div></section>
        <% } %>
      </div>

      <aside class="room-side">
        <% if (preview) { %>
          <div class="panel">
            <div class="panel-head"><h3><%- I('eye') %>Admin preview</h3></div>
            <div class="panel-body"><p class="small muted">Bid forms are shown as an eligible bidder would see them, but disabled. <a href="/admin/auctions/<%= a.id %>">Edit this auction</a>.</p></div>
          </div>
        <% } else if (!user) { %>
          <div class="panel">
            <div class="panel-head"><h3><%- I('gavel') %>Bid in this auction</h3></div>
            <div class="panel-body">
              <p>You need a verified bidder account to bid. Registration takes a few minutes; document checks usually take one working day.</p>
              <div class="form-actions">
                <% if (S.registration_open === '1') { %><a class="btn btn-accent" href="/register">Register to bid</a><% } %>
                <a class="btn btn-quiet" href="<%= loginHref %>">Sign in</a>
              </div>
            </div>
          </div>
        <% } else if (eligibility && !eligibility.ok && phase !== 'closed') { %>
          <div class="panel">
            <div class="panel-head"><h3><%- I('shield') %>Before you can bid</h3></div>
            <div class="panel-body"><%- include('../account/_steps') %></div>
          </div>
        <% } else if (eligibility && eligibility.ok && phase !== 'closed') { %>
          <div class="panel">
            <div class="panel-head"><h3><%- I('shield') %>Your eligibility</h3><span class="tag tag-ok">Cleared to bid</span></div>
            <div class="panel-body"><p class="small muted">Bidding as <b><%= user.company_name || user.name %></b>, bidder number <%= bidderNo(user.id) %>. Every bid you place is binding under the terms of sale.</p></div>
          </div>
        <% } %>

        <div class="panel" id="schedule">
          <div class="panel-head"><h3><%- I('calendar') %>Schedule</h3><span class="muted small">IST</span></div>
          <div class="panel-body">
            <dl class="kv">
              <dt>Starts</dt><dd><%= fmtDT(a.starts_at) %></dd>
              <dt><%= a.stagger_min > 0 ? 'First lot closes' : 'Ends' %></dt><dd><%= fmtDT(a.ends_at) %></dd>
              <% if (a.stagger_min > 0) { %>
                <dt>Lot closing</dt><dd>Lots close one after another, <%= plural(a.stagger_min, 'minute') %> apart, in lot number order</dd>
              <% } %>
              <dt>Extension</dt><dd><% if (a.extend_by_min > 0 && a.extend_window_min > 0) { %>A bid in the last <%= plural(a.extend_window_min, 'minute') %> extends that lot by <%= plural(a.extend_by_min, 'minute') %><% } else { %>Lots close on time, with no extension<% } %></dd>
              <dt>Highest bid</dt><dd><%= a.show_highest_bid ? 'Shown to all bidders' : 'Hidden from other bidders' %></dd>
            </dl>
          </div>
        </div>

        <% if (documents.length) { %>
          <div class="panel" id="documents">
            <div class="panel-head"><h3><%- I('doc') %>Documents</h3></div>
            <div class="panel-body" style="padding-top:6px;padding-bottom:6px">
              <ul class="doc-list">
                <% documents.forEach(function (d) { %>
                  <li><a href="/media/<%= d.file_id %>" target="_blank" rel="noopener"><span class="d-ico"><%- I(d.mime === 'application/pdf' ? 'doc' : 'image', 18) %></span><span><b><%= d.title %></b><span><%= d.mime === 'application/pdf' ? 'PDF' : 'Image' %>, <%= kb(d.size) %></span></span></a></li>
                <% }) %>
              </ul>
            </div>
          </div>
        <% } %>

        <% if (a.seller_name) { %>
          <div class="panel">
            <div class="panel-head"><h3><%- I('factory') %>Seller</h3></div>
            <div class="panel-body">
              <div class="seller-card">
                <% if (a.seller_logo) { %><img src="/media/<%= a.seller_logo %>" alt="" width="52" height="52" loading="lazy"><% } else { %><span class="s-ico"><%- I('factory', 24) %></span><% } %>
                <div><b><%= a.seller_name %></b><% if (a.seller_location) { %><span><%= a.seller_location %></span><% } %></div>
              </div>
              <% if (a.seller_description) { %><div class="rich small"><%- rich(a.seller_description) %></div><% } %>
              <p class="muted small" style="margin-top:12px">Questions about the material or inspection? <a href="/contact">Contact our auction desk</a><% if (S.contact_phone) { %> or call <%= S.contact_phone %><% } %>.</p>
            </div>
          </div>
        <% } %>
      </aside>
    </div>
  </div>
</div>
