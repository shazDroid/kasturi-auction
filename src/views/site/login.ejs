<div class="wrap narrow">
  <div class="page-head">
    <h1>Sign in</h1>
    <p>Use the email and password you registered with.</p>
  </div>
  <% if (formError) { %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
  <form class="panel" method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="panel-body">
      <div class="field">
        <label for="l-email">Email</label>
        <input type="email" id="l-email" name="email" value="<%= values.email %>" autocomplete="username" required autofocus>
      </div>
      <div class="field">
        <div class="row-between"><label for="l-pass">Password</label><a class="small" href="/forgot-password">Forgot your password?</a></div>
        <input type="password" id="l-pass" name="password" autocomplete="current-password" required>
      </div>
      <div class="form-actions"><button class="btn btn-block" type="submit">Sign in</button></div>
    </div>
  </form>
  <% if (S.registration_open === '1') { %><p class="muted section">New to <%= S.site_name %>? <a href="/register">Register your company as a bidder</a>.</p><% } %>
</div>
