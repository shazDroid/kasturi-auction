<section class="auth">
  <div class="wrap">
    <div class="auth-card">
      <div class="ac-body">
        <div class="ac-mark"><%- include('../partials/mark', { size: 40 }) %></div>
        <h1>Sign in</h1>
        <p class="ac-lead">Use the email and password you registered with.</p>
        <%- include('../partials/flash') %>
        <% if (formError) { %><div class="notice notice-error" role="alert"><%= formError %></div><% } %>
        <form method="post" action="/login">
          <input type="hidden" name="_csrf" value="<%= csrf %>">
          <div class="field">
            <label for="l-email">Email</label>
            <input type="email" id="l-email" name="email" value="<%= values.email %>" autocomplete="username" required autofocus>
          </div>
          <div class="field">
            <div class="row-between"><label for="l-pass">Password</label><a class="small" href="/forgot-password">Forgot your password?</a></div>
            <input type="password" id="l-pass" name="password" autocomplete="current-password" required>
          </div>
          <div class="form-actions"><button class="btn btn-block btn-lg" type="submit">Sign in</button></div>
        </form>
      </div>
      <% if (S.registration_open === '1') { %><div class="ac-foot">New to <%= S.site_name %>? <a href="/register">Register your company as a bidder</a>.</div><% } %>
    </div>
    <p class="auth-alt">Trouble signing in? <a href="/contact">Contact support</a><% if (S.contact_phone) { %> or call <%= S.contact_phone %><% } %>.</p>
  </div>
</section>
